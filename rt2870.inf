;
; WEP Key2
;
HKR, ,                WEPKey2,         0,""
HKR, Default,         WEPKey2,         0,""

;
; WEP Key3
;
HKR, ,                WEPKey3,         0,""
HKR, Default,         WEPKey3,         0,""

;
; WEP Key4
;
HKR, ,                WEPKey4,         0,""
HKR, Default,         WEPKey4,         0,""

[RemoveFlag.reg]
HKR, ,                SafelyRemoveOff,    0, "1"

;*******************************************************************************************
; DeviceID for Win9X 
;*******************************************************************************************
[USB_148F_2870.ndi.reg]
HKR, Ndi,                         DeviceID,        0, "USB\VID_148F&PID_2870"

[USB_148F_2770.ndi.reg]
HKR, Ndi,                         DeviceID,        0, "USB\VID_148F&PID_2770"

[USB_050D_8053.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_050D&PID_8053"

[USB_050D_815C.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_050D&PID_815C"

[USB_083A_B522.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_083A&PID_B522"

[USB_083A_7522.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_083A&PID_7522"

[USB_083A_7512.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_083A&PID_7512"

[USB_0471_200F.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_0471&PID_200F"

[USB_050D_8B5A.ndi.reg]
HKR, Ndi,                         DeviceID,         0, "USB\VID_050D&PID_8B5A"


[USB9X.ndi.reg]
HKR, ,                            NTMPDriver,       0, rt28709x.sys

HKR, ,                            BusType,          0, 15
HKR, NDI,                         CardType,         0, "PNP"

HKR, ,                            RunningWin9X,     0, "1"
HKR, ,                            DevLoader,        0, "*ndis"
HKR, ,                            DeviceVxDs,       0, "rt28709x.sys"
HKR, ,                            EnumPropPages,    0, "netdi.dll,EnumPropPages"

HKR, Ndi\Interfaces,              DefUpper,         0, "ndis3"
HKR, Ndi\Interfaces,              DefLower,         0, "ethernet"
HKR, Ndi\Interfaces,              UpperRange,       0, "ndis3"
HKR, Ndi\Interfaces,              LowerRange,       0, "ethernet"

HKR, NDIS,                        LogDriverName,    0, "rt28709x"
HKR, NDIS,                        MajorNdisVersion, 1, 03
HKR, NDIS,                        MinorNdisVersion, 1, 0A

;*******************************************************************************************
; DestinationDirs
;*******************************************************************************************

[DestinationDirs]
NT.CopyFiles            = 12    ; system32\drivers subdirectory on NT
win9x.CopyFiles         = 11    ; system32 subdirectory on win9x

[NT.CopyFiles]
rt2870.sys                       ; NT Installation

[win9x.CopyFiles]
rt28709x.sys                     ;  Win9x Installation

[SourceDisksNames]
1                       = %INSTALL_DISK_STR%,,,

[SourceDisksFiles] 
rt2870.sys              = 1
rt28709x.sys            = 1

;*******************************************************************************************
; NT specific
;*******************************************************************************************
[RTUSB.ndi.NT.reg]
HKR, Ndi,                   Service,            0, "rt2870"
HKR, Ndi\Interfaces,        UpperRange,         0, "ndis5"
HKR, Ndi\Interfaces,        LowerRange,         0, "ethernet"

[Generic.Service]
DisplayName                 = %Generic.Service.DispName%
ServiceType                 = 1                             ;%SERVICE_KERNEL_DRIVER%
StartType                   = 3                             ;%SERVICE_AUTO_START%
ErrorControl                = 1                             ;%SERVICE_ERROR_NORMAL%
ServiceBinary               = %12%\rt2870.sys
LoadOrderGroup              = NDIS

[common.EventLog]
AddReg=common.AddEventLog.reg

[common.AddEventLog.reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll,%%SystemRoot%%\System32\drivers\rt2870.sys"
HKR, , TypesSupported,   0x00010001, 7

;*******************************************************************************************
; Strings
;*******************************************************************************************
[strings]
Ralink                      = "Ralink Technology, Corp."
Belkin                      = "Belkin International, Inc."
SMC                         = "SMC Networks, Inc."
Arcadyan                    = "Arcadyan Technology Corporation"
philips                     = "Philips Consumer Electronics BV"
Ativa			    = "Ativa"

Generic.DeviceDesc          = "802.11n USB Wireless LAN Card"
Belkin.DeviceDesc           = "Belkin F5D8053 N Wireless USB Adapter"
SMC.DeviceDesc              = "EZ Connect N Draft 11n Wireless USB2.0 Adapter"
Arcadyan.DeviceDesc         = "802.11N Wireless USB Adapter"
philips.DeviceDesc          = "Philips 802.11n Wireless USB Adapter"
Ativa.DeviceDesc            = "Ativa Wireless N USB Adapter"


INSTALL_DISK_STR            = "Wireless 11n USB Installation Disk"

Generic.Service.DispName     = "Ralink 802.11n USB Wireless LAN Card Driver"

;
; Don't put spaces around=sign otherwise installer will not be able to
; find these lines.
; SSID_DEF_STR                = ""
VENDOR_DESC_DEF_STR         = "IEEE 802.11n Wireless Card."
NETWORK_TYPE_DEF_STR        = "1"
CHANNEL                     = "1"
WPS_DEVNAME_DEF_STR         = "Ralink Client"

